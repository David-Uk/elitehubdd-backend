{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "cross-env NODE_OPTIONS=\"--max-old-space-size=512 --optimize-for-size --max-semi-space-size=64 --no-liftoff\" NODE_ENV=test DB_SSL=true node server.js",
    "start:test": "cross-env NODE_OPTIONS=\"--max-old-space-size=512 --optimize-for-size --max-semi-space-size=64 --no-liftoff\" NODE_ENV=test DB_SSL=true node server.js",
    "start:prod": "cross-env NODE_OPTIONS=\"--max-old-space-size=512 --optimize-for-size --max-semi-space-size=64 --no-liftoff\" NODE_ENV=production node server.js",
    "dev:test": "cross-env NODE_ENV=test DB_SSL=true node --watch server.js",
    "dev": "cross-env NODE_ENV=development DEBUG=backend:* node --watch server.js",
    "prod": "cross-env NODE_ENV=production node server.js",
    "cpanel": "node cpanel-start.js",
    "cpanel:start": "cross-env NODE_OPTIONS=\"--max-old-space-size=512 --optimize-for-size --max-semi-space-size=64 --no-liftoff\" UV_THREADPOOL_SIZE=4 NODE_ENV=production node server.js",
    "pm2:start": "cross-env NODE_ENV=production pm2 start server.js -i max --name elitehub",
    "pm2:stop": "pm2 stop elitehub",
    "pm2:restart": "pm2 restart elitehub",
    "pm2:logs": "pm2 logs elitehub",
    "pm2:monit": "pm2 monit",
    "logs:error": "tail -f logs/error-*.log",
    "logs:combined": "tail -f logs/combined-*.log",
    "logs:http": "tail -f logs/http-*.log",
    "db:migrate": "cross-env NODE_ENV=test DB_SSL=true sequelize-cli db:migrate",
    "db:migrate:undo": "cross-env NODE_ENV=test DB_SSL=true sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "cross-env NODE_ENV=test DB_SSL=true sequelize-cli db:migrate:undo:all",
    "db:migrate:prod": "cross-env NODE_ENV=production sequelize-cli db:migrate",
    "db:migrate:prod:undo": "cross-env NODE_ENV=production sequelize-cli db:migrate:undo",
    "db:migrate:prod:undo:all": "cross-env NODE_ENV=production sequelize-cli db:migrate:undo:all",
    "db:migrate:test": "cross-env NODE_ENV=test sequelize-cli db:migrate",
    "db:migrate:test:undo": "cross-env NODE_ENV=test sequelize-cli db:migrate:undo",
    "db:migrate:test:undo:all": "cross-env NODE_ENV=test sequelize-cli db:migrate:undo:all",
    "db:seed": "cross-env NODE_ENV=test DB_SSL=true sequelize-cli db:seed:all",
    "db:seed:undo": "cross-env NODE_ENV=test DB_SSL=true sequelize-cli db:seed:undo:all",
    "db:seed:prod": "cross-env NODE_ENV=production sequelize-cli db:seed:all",
    "db:seed:prod:undo": "cross-env NODE_ENV=production sequelize-cli db:seed:undo:all",
    "db:seed:test": "cross-env NODE_ENV=test sequelize-cli db:seed:all",
    "db:seed:test:undo": "cross-env NODE_ENV=test sequelize-cli db:seed:undo:all",
    "db:reset": "cross-env NODE_ENV=test DB_SSL=true sequelize-cli db:migrate:undo:all && cross-env NODE_ENV=test DB_SSL=true sequelize-cli db:migrate && cross-env NODE_ENV=test DB_SSL=true sequelize-cli db:seed:all",
    "db:reset:prod": "cross-env NODE_ENV=production sequelize-cli db:migrate:undo:all && cross-env NODE_ENV=production sequelize-cli db:migrate && cross-env NODE_ENV=production sequelize-cli db:seed:all",
    "db:reset:test": "cross-env NODE_ENV=test sequelize-cli db:migrate:undo:all && cross-env NODE_ENV=test sequelize-cli db:migrate && cross-env NODE_ENV=test sequelize-cli db:seed:all",
    "migrate:prod": "node scripts/migrate-prod.js",
    "migrate:test": "node scripts/migrate-test.js",
    "db:check": "node scripts/check-db.js"
  },
  "keywords": [
    "PERN",
    "backend",
    "elitehub",
    "elitehub-backend",
    "elitehub-backend-api",
    "elitehub-backend-server"
  ],
  "author": "David Ukelere",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "debug": "^4.4.3",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.4.1",
    "jimp": "^1.6.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.12",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "redis": "^4.7.0",
    "sequelize": "^6.37.7",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^2.0.6",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xss-clean": "^0.1.4",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.5.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "sequelize-cli": "^6.6.3"
  }
}
