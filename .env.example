# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=mockuser
DB_PASSWORD=MockPassword123!
DB_NAME=elitehub
DB_NAME_TEST=elitehub_test

# Application
NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=mock_jwt_secret_key_123456
JWT_EXPIRE=30d

# Testing Database Configuration
DATABASE_URL_TEST="postgres://mockadmin:MockPass123@mock-host.example.com:12345/defaultdb?sslmode=require"

# SSL Configuration
DB_SSL=false
DB_SSL_CA=mock-ca.pem

# Redis Configuration
REDIS_URL=redis://default:MockRedisPass123@redis-mock.example.com:15000

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=mock_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=mock_cloudinary_secret_12345

# Logging
LOG_LEVEL=info

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
